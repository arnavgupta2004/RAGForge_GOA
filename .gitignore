__pycache__/
*.pyc
.venv/
venv/
.env
*.egg-info/

# the curated raw subset (msmarco_xi.jsonl, ~3.4MB) IS committed for full
# reproducibility without re-hitting HuggingFace; only re-downloadable scratch
# state is ignored here
data/raw/*
!data/raw/.gitkeep
!data/raw/msmarco_xi.jsonl

# processed indices ARE committed via Git LFS (see .gitattributes) so a fresh
# clone can serve immediately without rerunning scripts/build_index.py
data/benchmarks/*.jsonl
!data/benchmarks/.gitkeep

node_modules/
dist/
frontend/dist/
.DS_Store
*.log
.pytest_cache/
.mypy_cache/
.ruff_cache/
