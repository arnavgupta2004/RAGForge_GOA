# --- ASR (speech-to-text) ---
# https://docs.sarvam.ai/api-reference-docs/speech-to-text/transcribe
SARVAM_API_KEY=

# --- Generation ---
# https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- App config ---
APP_ENV=development
RAGFORGE_CONFIG=configs/development.yaml

# CORS origin(s) for the deployed frontend, comma-separated
CORS_ORIGINS=http://localhost:5173
