# --- ASR (speech-to-text) ---
# https://docs.sarvam.ai/api-reference-docs/speech-to-text/transcribe
SARVAM_API_KEY=

# --- Generation ---
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- App config ---
APP_ENV=development
RAGFORGE_CONFIG=configs/development.yaml

# CORS origin(s) for the deployed frontend, comma-separated
CORS_ORIGINS=http://localhost:5173
